# Copy to .env.local. Only public, non-secret config belongs here — this
# gets bundled into client-side JS and is visible to anyone.

# Leave unset in local dev: the Vite dev server proxies /api to Django (see vite.config.ts).
# Set this for production builds, to the deployed backend's public API origin + /api/v1.
# VITE_API_URL=https://api.example.com/api/v1
