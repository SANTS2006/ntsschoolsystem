# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL connection string (pooled connection recommended).
# Get this from your Neon project dashboard -> Connection Details.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=School Management Platform

# --- Daily.co (live video lessons) --- leave blank to disable; live sessions return a clean
# "not configured" error instead of breaking anything else.
DAILY_API_KEY=

# --- Production only ---
# SENTRY_DSN=

# --- Backup & recovery (see docs/BACKUP_AND_RECOVERY.md) ---
# r2 (Cloudflare R2, recommended) | s3 | cloudinary | local. Defaults to r2 when the four BACKUP_R2_* values are set,
# else cloudinary when it is configured.
BACKUP_STORAGE=
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep a copy somewhere safe and separate from the server - without it backups cannot be read.
BACKUP_ENCRYPTION_KEY=
BACKUP_ALLOW_RESTORE=True
# Optional: lets an external scheduler call POST /api/v1/platform/backups/tick/ (header X-Backup-Token).
BACKUP_TICK_TOKEN=
# Cloudflare R2: dash.cloudflare.com -> R2 -> create a PRIVATE bucket -> Manage R2 API Tokens (Object Read & Write,
# scoped to that bucket). The account id is on the R2 overview page.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Any other S3-compatible storage (only if BACKUP_STORAGE=s3)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Public website enquiries (apps/enquiries): where demo requests / contact messages are e-mailed (needs BREVO_API_KEY).
# They are stored in the database regardless; read them in the platform console under "Website enquiries".
ENQUIRY_NOTIFY_EMAIL=hello@ntsdigitalsolutions.com
